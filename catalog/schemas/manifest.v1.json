{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portside.gg/schemas/manifest.v1.json",
  "title": "Portside port manifest (schema 1)",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema",
    "id",
    "game_key",
    "status",
    "source",
    "builds"
  ],
  "properties": {
    "schema": {
      "const": 1,
      "type": "number"
    },
    "id": {
      "maxLength": 200,
      "pattern": "^[a-z0-9-]+$",
      "minLength": 1,
      "type": "string"
    },
    "game_key": {
      "maxLength": 200,
      "pattern": "^[a-z0-9-]+$",
      "minLength": 1,
      "type": "string"
    },
    "display_name": {
      "maxLength": 200,
      "type": "string"
    },
    "status": {
      "description": "docs/specs/catalog.md",
      "anyOf": [
        {
          "const": "perfect",
          "type": "string"
        },
        {
          "const": "playable",
          "type": "string"
        },
        {
          "const": "in_progress",
          "type": "string"
        },
        {
          "const": "boots",
          "type": "string"
        },
        {
          "const": "not_playable",
          "type": "string"
        }
      ]
    },
    "status_notes": {
      "maxLength": 2000,
      "type": "string"
    },
    "source": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "anyOf": [
            {
              "const": "github_releases",
              "type": "string"
            },
            {
              "const": "github_actions_artifact",
              "type": "string"
            },
            {
              "const": "url_list",
              "type": "string"
            }
          ]
        },
        "repo": {
          "maxLength": 1000,
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "type": "string"
        },
        "channel": {
          "anyOf": [
            {
              "const": "stable",
              "type": "string"
            },
            {
              "const": "prerelease",
              "type": "string"
            },
            {
              "const": "tag_pattern",
              "type": "string"
            }
          ]
        },
        "tag_pattern": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "min_version": {
          "maxLength": 64,
          "type": "string"
        },
        "version": {
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$",
          "type": "string"
        },
        "released": {
          "maxLength": 40,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}(T[0-9:.]+(Z|[+-]\\d{2}:\\d{2}))?$",
          "type": "string"
        },
        "release_url": {
          "maxLength": 500,
          "pattern": "^https://",
          "type": "string"
        },
        "hosts": {
          "minItems": 1,
          "maxItems": 8,
          "type": "array",
          "items": {
            "maxLength": 253,
            "pattern": "^[a-z0-9.-]+$",
            "type": "string"
          }
        }
      }
    },
    "builds": {
      "minItems": 1,
      "maxItems": 32,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "os",
          "arch",
          "asset",
          "archive"
        ],
        "properties": {
          "os": {
            "anyOf": [
              {
                "const": "windows",
                "type": "string"
              },
              {
                "const": "macos",
                "type": "string"
              },
              {
                "const": "linux",
                "type": "string"
              },
              {
                "const": "android",
                "type": "string"
              }
            ]
          },
          "arch": {
            "anyOf": [
              {
                "const": "x86_64",
                "type": "string"
              },
              {
                "const": "arm64",
                "type": "string"
              },
              {
                "const": "universal",
                "type": "string"
              }
            ]
          },
          "asset": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "archive": {
            "anyOf": [
              {
                "const": "zip",
                "type": "string"
              },
              {
                "const": "tar.gz",
                "type": "string"
              },
              {
                "const": "tar.xz",
                "type": "string"
              },
              {
                "const": "7z",
                "type": "string"
              },
              {
                "const": "none",
                "type": "string"
              },
              {
                "const": "apk",
                "type": "string"
              },
              {
                "const": "dmg",
                "type": "string"
              },
              {
                "const": "appimage",
                "type": "string"
              }
            ]
          },
          "nested": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "file",
              "archive"
            ],
            "properties": {
              "file": {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              "archive": {
                "anyOf": [
                  {
                    "const": "zip",
                    "type": "string"
                  },
                  {
                    "const": "tar.gz",
                    "type": "string"
                  },
                  {
                    "const": "tar.xz",
                    "type": "string"
                  },
                  {
                    "const": "7z",
                    "type": "string"
                  },
                  {
                    "const": "none",
                    "type": "string"
                  },
                  {
                    "const": "apk",
                    "type": "string"
                  },
                  {
                    "const": "dmg",
                    "type": "string"
                  },
                  {
                    "const": "appimage",
                    "type": "string"
                  }
                ]
              }
            }
          },
          "strip_root": {
            "type": "boolean"
          },
          "launch": {
            "additionalProperties": false,
            "type": "object",
            "properties": {
              "exe": {
                "maxLength": 1000,
                "type": "string"
              },
              "app_bundle": {
                "maxLength": 1000,
                "type": "string"
              },
              "args": {
                "maxItems": 64,
                "type": "array",
                "items": {
                  "maxLength": 1000,
                  "type": "string"
                }
              },
              "cwd": {
                "maxLength": 1000,
                "type": "string"
              },
              "env": {
                "type": "object",
                "patternProperties": {
                  "^(.*)$": {
                    "maxLength": 1000,
                    "type": "string"
                  }
                }
              },
              "chmod_x": {
                "type": "boolean"
              }
            }
          },
          "checksum": {
            "anyOf": [
              {
                "const": "upstream",
                "type": "string"
              },
              {
                "const": "attestation",
                "type": "string"
              },
              {
                "const": "none",
                "type": "string"
              }
            ]
          },
          "unsigned": {
            "type": "boolean"
          },
          "url": {
            "maxLength": 500,
            "pattern": "^https://",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "size": {
            "minimum": 1,
            "type": "integer"
          },
          "android_package": {
            "maxLength": 1000,
            "pattern": "^[A-Za-z][\\w]*(\\.[A-Za-z][\\w]*)+$",
            "type": "string"
          }
        }
      }
    },
    "assets_required": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "label",
          "accept"
        ],
        "properties": {
          "id": {
            "maxLength": 64,
            "pattern": "^[a-z0-9_-]+$",
            "type": "string"
          },
          "label": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "accept": {
            "minItems": 1,
            "type": "array",
            "items": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "sha1": {
                  "pattern": "^[0-9a-f]{40}$",
                  "type": "string"
                },
                "sha256": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                "name": {
                  "maxLength": 200,
                  "minLength": 1,
                  "type": "string"
                }
              }
            }
          },
          "formats": {
            "type": "array",
            "items": {
              "maxLength": 16,
              "type": "string"
            }
          },
          "normalize": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "import": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "anyOf": [
                  {
                    "const": "copy",
                    "type": "string"
                  },
                  {
                    "const": "extract_with_port",
                    "type": "string"
                  },
                  {
                    "const": "pick_folder",
                    "type": "string"
                  }
                ]
              },
              "dest": {
                "maxLength": 1000,
                "type": "string"
              },
              "run": {
                "anyOf": [
                  {
                    "maxLength": 1000,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "saves": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "root"
      ],
      "properties": {
        "root": {
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "windows": {
              "maxLength": 1000,
              "type": "string"
            },
            "macos": {
              "maxLength": 1000,
              "type": "string"
            },
            "linux": {
              "maxLength": 1000,
              "type": "string"
            },
            "android": {
              "maxLength": 1000,
              "type": "string"
            }
          }
        },
        "include": {
          "type": "array",
          "items": {
            "maxLength": 1000,
            "type": "string"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "maxLength": 1000,
            "type": "string"
          }
        },
        "portable": {
          "type": "boolean"
        },
        "tied_to_version": {
          "type": "boolean"
        },
        "converter": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "multiplayer": {
      "anyOf": [
        {
          "const": "none",
          "type": "string"
        },
        {
          "const": "local",
          "type": "string"
        },
        {
          "const": "online_coop",
          "type": "string"
        },
        {
          "const": "online_pvp",
          "type": "string"
        }
      ]
    },
    "online": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "join_uri": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "redistribution": {
      "type": "boolean"
    },
    "maintainers_verified": {
      "type": "boolean"
    },
    "links": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "changelog": {
      "type": "array",
      "items": {
        "maxLength": 1000,
        "type": "string"
      }
    }
  }
}
