# Where the static catalog is published (docs/specs/static-catalog.md). Default: the public
# app repository's GitHub Pages site, https://erickbarrera.github.io/portside
# PUBLIC_PORTSIDE_CATALOG_URL=https://erickbarrera.github.io/portside

# Build-time override (server side only). Defaults to PUBLIC_PORTSIDE_CATALOG_URL.
# `pnpm dev:mock` sets this to the local mock, http://localhost:4010.
# PORTSIDE_CATALOG_URL=http://localhost:4010

# Where the site itself is published (astro.config.mjs). The publish workflow sets them for
# GitHub Pages: https://erickbarrera.github.io + /portside. Locally the site runs at /.
# PORTSIDE_SITE_URL=https://erickbarrera.github.io
# PORTSIDE_SITE_BASE=/portside
