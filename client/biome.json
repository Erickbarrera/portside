{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "files": {
    "include": ["*.json", "ui/**/*.ts", "ui/**/*.js", "ui/**/*.json"],
    "ignore": [
      "**/node_modules",
      "**/build",
      "**/.svelte-kit",
      "ui/src/lib/ipc/bindings.ts",
      "src-tauri/gen",
      "target"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  }
}
